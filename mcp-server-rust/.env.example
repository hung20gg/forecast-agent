# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id

# Path to service account credentials JSON file
# For local development, place your bigquery.json in the keys/ directory
GOOGLE_APPLICATION_CREDENTIALS=./keys/bigquery.json

# Optional: Limit queries to data before this date (YYYY-MM-DD format)
# LIMIT_TIME=2025-01-01

# Logging level: error, warn, info, debug, trace
RUST_LOG=info
