# ===========================================
# CENTRALIZED ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# ===== LLM Module Configuration =====
# Optional: URL to clone the LLM repository during Docker build
# Leave empty if you've already cloned it locally in agent/llm/
LLM_REPO_URL=https://github.com/hung20gg/llm.git

# ===== LLM API Keys =====
OPENAI_API_KEY=sk-your-openai-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# ===== MCP Server Configuration =====
MCP_SERVER_URL=http://mcp-server:9003/sse
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=9003

# ===== Google Cloud / BigQuery Configuration =====
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/keys/bigquery.json
LIMIT_TIME=2025-01-01

# ===== Backend API Configuration =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_KEY=

# ===== Frontend Configuration =====
FRONTEND_PORT=3000
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
